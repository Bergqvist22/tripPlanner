# Copy to .env.local. Points at the Postgres from docker-compose.yml.
DATABASE_URL=postgres://tripplanner:tripplanner@localhost:54329/tripplanner

# Optional. Where daily exchange rates are fetched from, if not from
# https://api.frankfurter.dev/v2/rates?base=EUR (same format).
# EXCHANGE_RATES_URL=

# Optional. Where places are searched for, if not at
# https://photon.komoot.io/api/ (same format).
# PLACE_SEARCH_URL=
