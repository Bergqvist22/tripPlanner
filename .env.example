# Copy to .env.local. Points at the Postgres from docker-compose.yml.
DATABASE_URL=postgres://tripplanner:tripplanner@localhost:54329/tripplanner

# Optional. Where daily exchange rates are fetched from, if not from
# https://api.frankfurter.dev/v2/rates?base=EUR (same format).
# EXCHANGE_RATES_URL=

# Optional. Where places are searched for, if not at
# https://photon.komoot.io/api/ (same format).
# PLACE_SEARCH_URL=

# Optional. Where drives are calculated, if not at
# https://router.project-osrm.org (same format).
# ROUTE_CALCULATION_URL=

# Needed for the daily job that purges what was deleted more than 30 days ago
# (/api/cron/purge-deleted): the job runs only for a request carrying this
# secret. On Vercel, set it on the project and the scheduler sends it.
# CRON_SECRET=
